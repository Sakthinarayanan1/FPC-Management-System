# ==============================================================================
# FPC Management System - Local Environment Configuration
# ==============================================================================
# Copy this file to .env or set environment variables as needed.
# Safe defaults are already built into the application for local development.

# --- Frontend (artifacts/fpc-management) ---
# Port for Vite development server (default: 3000)
PORT=3000

# Base URL path for the frontend (default: /)
BASE_PATH=/

# --- Backend API (artifacts/api-server) ---
# Port for Express API server (default: 5000)
# PORT=5000

# Logging level for backend: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Node environment: development | production
NODE_ENV=development

# --- Database (lib/db) [Optional - future backend persistence] ---
# Connection string for PostgreSQL database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fpc_db

