# ==============================================================================
# FPC Management System - Environment Configuration
# ==============================================================================
# Copy this file to .env in the project root:
#   cp .env.example .env
#
# Credentials are kept strictly on the backend and NEVER exposed to frontend clients.

# --- Frontend (artifacts/fpc-management) ---
# Port for Vite development server (default: 3000)
PORT=3000

# Base URL path for the frontend (default: /)
BASE_PATH=/

# Target API URL for Vite dev proxy (default: http://127.0.0.1:5000)
API_TARGET=http://127.0.0.1:5000

# --- Backend API (artifacts/api-server) ---
# Port for Express API server (default: 5000)
# PORT=5000

# Logging level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Node environment: development | production
NODE_ENV=development

# --- Database (lib/db) [Optional - Future Persistence] ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fpc_db

# ==============================================================================
# REAL EMAIL INTEGRATION (Nodemailer / SMTP)
# ==============================================================================
# Choose ONE of the providers below and uncomment its variables in your .env:

# --- OPTION 1: Gmail SMTP (Recommended for quick testing) ---
# Step 1: Ensure 2-Step Verification is turned ON in your Google Account:
#         https://myaccount.google.com/security
# Step 2: Generate a 16-character Google App Password under "App passwords":
#         https://myaccount.google.com/apppasswords (select App: Mail, Device: Windows/Other)
# Step 3: Enter your full Gmail address and the 16-character App Password below.
#         (Spaces in App Password like "abcd efgh ijkl mnop" are automatically stripped by the system).
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-actual-email@gmail.com
# SMTP_PASS=your-16-char-app-password
# EMAIL_FROM=Tata Steel Foundation <your-actual-email@gmail.com>

# --- OPTION 2: Resend SMTP ---
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=resend
# SMTP_PASS=re_your_resend_api_key_here
# EMAIL_FROM=Tata Steel Foundation <onboarding@yourverifieddomain.com>

# --- OPTION 3: SendGrid SMTP ---
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=SG.your_sendgrid_api_key_here
# EMAIL_FROM=Tata Steel Foundation <onboarding@yourverifieddomain.com>

# --- OPTION 4: Custom Enterprise / Corporate SMTP ---
# SMTP_HOST=smtp.your-company.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=smtp-user
# SMTP_PASS=smtp-password
# EMAIL_FROM=Tata Steel Foundation <onboarding@your-company.com>

# --- OPTION 5: Automatic Local Development (Default) ---
# If SMTP_HOST and SMTP_USER are left commented or empty, the backend automatically provisions
# a real Ethereal SMTP test account on the fly. Dispatched emails receive real provider message IDs
# and viewable web inbox preview URLs in the UI and terminal.

# --- Application URL Configuration ---
# Used for generating valid public onboarding invitation links in emails
APP_URL=http://localhost:3000
