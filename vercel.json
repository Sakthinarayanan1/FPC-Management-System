{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api-server": {
      "root": "artifacts/api-server",
      "framework": "express",
      "entrypoint": "src/index.ts",
      "buildCommand": "pnpm run build"
    },
    "mockup-sandbox": {
      "root": "artifacts/mockup-sandbox",
      "framework": "vite",
      "outputDirectory": "dist"
    },
    "fpc-management": {
      "root": "artifacts/fpc-management",
      "framework": "vite",
      "outputDirectory": "dist/public"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api-server"
      }
    },
    {
      "source": "/__mockup",
      "destination": {
        "service": "mockup-sandbox"
      }
    },
    {
      "source": "/__mockup/(.*)",
      "destination": {
        "service": "mockup-sandbox"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "fpc-management"
      }
    }
  ]
}

